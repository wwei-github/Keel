# 复制为 .env 后按需修改。不要提交 .env。

# --- 环境 ---
KEEL_ENV=local
KEEL_LOG_LEVEL=INFO
KEEL_LOG_JSON=true

# --- PostgreSQL：状态库 + 事件队列（§2.5.2）---
KEEL_PG_DSN=postgresql://keel:keel@localhost:5432/keel

# --- 存储 ---
KEEL_DUCKDB_PATH=data/duckdb/keel.duckdb
KEEL_RAW_ROOT=data/raw
KEEL_ARTIFACT_ROOT=data/artifacts

# --- 服务 API ---
# 留空 = 开发模式不鉴权。部署前必须设置。
KEEL_API_TOKEN=
KEEL_API_HOST=127.0.0.1
KEEL_API_PORT=8000

# --- 交易所（V1–V2 只有 Binance 现货，ADR-001）---
KEEL_EXCHANGE_ID=binance
KEEL_EXCHANGE_API_KEY=
KEEL_EXCHANGE_API_SECRET=

# --- 告警（§2.5.7）---
KEEL_ALERT_TELEGRAM_TOKEN=
KEEL_ALERT_TELEGRAM_CHAT_ID=
KEEL_ALERT_LOCAL_NOTIFY=true
